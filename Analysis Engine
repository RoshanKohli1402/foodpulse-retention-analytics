# 5. BUSINESS INSIGHTS
# ============================================================

def generate_insights(df, rfm, retention):
    """Extract and print key business insights."""
    print("\n" + "="*60)
    print("  FOODPULSE — KEY BUSINESS INSIGHTS")
    print("="*60)

    # Revenue summary
    total_rev = df['order_value'].sum()
    total_orders = len(df)
    aov = total_rev / total_orders
    print(f"\n📦 Total Orders (excl. cancelled): {total_orders:,}")
    print(f"💰 Total Revenue: ₹{total_rev:,.0f}")
    print(f"🧾 Average Order Value: ₹{aov:.1f}")

    # Champion revenue share
    champion_rev = rfm[rfm['segment'] == 'Champions']['monetary'].sum()
    print(f"\n🏆 Champions Revenue Share: {champion_rev/rfm['monetary'].sum()*100:.1f}%")
    print(f"   (Champions = {len(rfm[rfm['segment']=='Champions'])} customers, "
          f"{len(rfm[rfm['segment']=='Champions'])/len(rfm)*100:.1f}% of base)")

    # At-risk revenue at stake
    at_risk = rfm[rfm['segment'] == 'At Risk']
    print(f"\n⚠️  At-Risk Customers: {len(at_risk):,}")
    print(f"   Revenue at stake: ₹{at_risk['monetary'].sum():,.0f}")
    print(f"   Avg recency: {at_risk['recency'].mean():.0f} days since last order")

    # Month-1 retention
    m1_avg = retention[1].mean()
    print(f"\n📉 Avg Month-1 Retention: {m1_avg:.1f}%")
    print(f"   (Critical churn window — target with D+3 push notification)")

    # Top city
    top_city = df.groupby('city')['order_value'].sum().idxmax()
    top_city_rev = df.groupby('city')['order_value'].sum().max()
    print(f"\n🏙️  Top Revenue City: {top_city} (₹{top_city_rev:,.0f})")

    # Top cuisine
    top_cuisine = df.groupby('cuisine')['order_id'].count().idxmax()
    print(f"🍛 Most Ordered Cuisine: {top_cuisine}")

    print("\n" + "="*60)


