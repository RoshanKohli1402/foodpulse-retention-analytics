function showPage(id, el) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  el.classList.add('active');
}

// ===== OVERVIEW CHARTS =====
const labels = DATA.monthly.map(d=>d.order_month.slice(5)=='01'?d.order_month.slice(0,4):'');
const fullLabels = DATA.monthly.map(d=>d.order_month);

new Chart(document.getElementById('revenueChart'), {
  type:'line',
  data:{
    labels:fullLabels,
    datasets:[{
      label:'Revenue (₹)',
      data:DATA.monthly.map(d=>d.revenue),
      borderColor:'#ff4d00',
      backgroundColor:'rgba(255,77,0,0.05)',
      fill:true,
      tension:0.4,
      pointRadius:0,
      borderWidth:2
    },{
      label:'Orders',
      data:DATA.monthly.map(d=>d.orders*350),
      borderColor:'#06d6a0',
      backgroundColor:'rgba(6,214,160,0.03)',
      fill:true,
      tension:0.4,
      pointRadius:0,
      borderWidth:1.5,
      borderDash:[4,4]
    }]
  },
  options:{
    responsive:true,
    interaction:{mode:'index',intersect:false},
    plugins:{legend:{display:true,position:'top'},tooltip:{callbacks:{label:ctx=>ctx.datasetIndex===0?`₹${(ctx.raw/1000).toFixed(0)}K`:`${(ctx.raw/350).toFixed(0)} orders`}}},
    scales:{x:{ticks:{maxTicksLimit:12,maxRotation:0}},y:{ticks:{callback:v=>`₹${(v/1000).toFixed(0)}K`}}}
  }
});

new Chart(document.getElementById('platformChart'), {
  type:'doughnut',
  data:{
    labels:['App','Web'],
    datasets:[{data:[52,48],backgroundColor:['#ff4d00','#118ab2'],borderWidth:0,hoverOffset:8}]
  },
  options:{responsive:true,plugins:{legend:{position:'bottom'}}}
});

new Chart(document.getElementById('aovChart'), {
  type:'bar',
  data:{
    labels:fullLabels,
    datasets:[{label:'Avg Order Value (₹)',data:DATA.monthly.map(d=>d.avg_order_value),backgroundColor:'rgba(255,140,66,0.7)',borderRadius:3}]
  },
  options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{min:340,ticks:{callback:v=>`₹${v}`}}}}
});

// ===== COHORT HEATMAP =====
function getColor(val) {
  if(val===null||val===undefined) return 'transparent';
  if(val>=80) return `rgba(255,77,0,0.9)`;
  if(val>=40) return `rgba(255,140,66,${val/100*1.2})`;
  if(val>=20) return `rgba(255,209,102,${val/50})`;
  return `rgba(6,214,160,${val/25})`;
}

const table = document.getElementById('cohortTable');
const headerRow = document.createElement('tr');
['Cohort','M0','M1','M2','M3','M4','M5','M6'].forEach(h=>{
  const th=document.createElement('th'); th.textContent=h; headerRow.appendChild(th);
});
table.appendChild(headerRow);

DATA.retention.forEach(row=>{
  const tr=document.createElement('tr');
  const td0=document.createElement('td'); td0.textContent=row.cohort; tr.appendChild(td0);
  ['m0','m1','m2','m3','m4','m5','m6'].forEach(m=>{
    const td=document.createElement('td');
    const v=row[m];
    td.textContent=v?v.toFixed(1)+'%':'—';
    td.style.background=getColor(v);
    td.style.color=v>=40?'#fff':'var(--text)';
    td.title=`${row.cohort} ${m.toUpperCase()}: ${v?v.toFixed(1)+'%':'N/A'}`;
    tr.appendChild(td);
  });
  table.appendChild(tr);
});

// Avg retention line
const avgRetention = ['m1','m2','m3','m4','m5','m6'].map(m=>{
  const vals = DATA.retention.map(r=>r[m]).filter(v=>v);
  return vals.reduce((a,b)=>a+b,0)/vals.length;
});
new Chart(document.getElementById('retentionLineChart'),{
  type:'line',
  data:{labels:['M1','M2','M3','M4','M5','M6'],datasets:[{label:'Avg Retention %',data:avgRetention,borderColor:'#ff4d00',backgroundColor:'rgba(255,77,0,0.08)',fill:true,tension:0.4,pointBackgroundColor:'#ff4d00',pointRadius:5}]},
  options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{min:0,max:100,ticks:{callback:v=>v+'%'}}}}
});

new Chart(document.getElementById('cohortSizeChart'),{
  type:'bar',
  data:{labels:DATA.retention.map(r=>r.cohort),datasets:[{label:'Cohort Size (est.)',data:DATA.retention.map((r,i)=>380+i*12),backgroundColor:'rgba(17,138,178,0.7)',borderRadius:4}]},
  options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{ticks:{maxRotation:45}}}}
});

// ===== RFM =====
const rfmColors = {'Champions':'#ff4d00','Loyal Customers':'#ff8c42','At Risk':'#ffd166','Lost':'#6b6b80','Potential Loyalists':'#06d6a0','Recent Customers':'#118ab2'};
const segDescs = {'Champions':'High R, F & M. Reward them, ask for reviews, upsell premium.','Loyal Customers':'Order regularly. Offer loyalty points and early access.','At Risk':'Used to buy often. Send re-engagement offers immediately.','Lost':'Long inactive. Win-back campaign with heavy discount.','Potential Loyalists':'Recent customers with decent frequency. Nurture them.','Recent Customers':'Just joined. First impression is critical — ensure great experience.'};

new Chart(document.getElementById('rfmDonut'),{
  type:'doughnut',
  data:{labels:DATA.rfm.map(r=>r.segment),datasets:[{data:DATA.rfm.map(r=>r.count),backgroundColor:DATA.rfm.map(r=>rfmColors[r.segment]||'#fff'),borderWidth:0,hoverOffset:12}]},
  options:{responsive:true,plugins:{legend:{position:'right',labels:{font:{size:10}}}}}
});

new Chart(document.getElementById('rfmBar'),{
  type:'bar',
  data:{labels:DATA.rfm.map(r=>r.segment),datasets:[{label:'Avg Revenue (₹)',data:DATA.rfm.map(r=>r.avg_monetary),backgroundColor:DATA.rfm.map(r=>rfmColors[r.segment]||'#fff'),borderRadius:6}]},
  options:{responsive:true,plugins:{legend:{display:false}},scales:{x:{ticks:{font:{size:9},maxRotation:20}},y:{ticks:{callback:v=>`₹${v.toFixed(0)}`}}}}
});

const rfmCardsEl = document.getElementById('rfmCards');
DATA.rfm.forEach(seg=>{
  const col = rfmColors[seg.segment]||'#fff';
  const div = document.createElement('div');
  div.className='rfm-card';
  div.style.borderColor=col+'33';
  div.querySelector||'';
  div.innerHTML=`<style>.rfm-card::before{background:${col}}</style>
    <div class="rfm-seg-name" style="color:${col}">${seg.segment}</div>
    <div class="rfm-count">${seg.count} customers</div>
    <div class="rfm-stats">
      <div class="rfm-stat"><div class="rfm-stat-val">₹${seg.avg_monetary.toFixed(0)}</div><div class="rfm-stat-lbl">Avg LTV</div></div>
      <div class="rfm-stat"><div class="rfm-stat-val">${seg.avg_frequency.toFixed(1)}x</div><div class="rfm-stat-lbl">Frequency</div></div>
      <div class="rfm-stat"><div class="rfm-stat-val">${seg.avg_recency.toFixed(0)}d</div><div class="rfm-stat-lbl">Recency</div></div>
    </div>
    <div style="font-size:10px;color:var(--muted);margin-top:12px;line-height:1.5">${segDescs[seg.segment]||''}</div>`;
  rfmCardsEl.appendChild(div);
});

// ===== GEO =====
const maxRev = Math.max(...DATA.cities.map(c=>c.revenue));
const cityEl = document.getElementById('cityBars');
cityEl.innerHTML='<div class="card-title">Revenue by City (₹)</div>';
DATA.cities.forEach((city,i)=>{
  const pct = (city.revenue/maxRev*100).toFixed(1);
  const div=document.createElement('div'); div.className='city-row';
  div.innerHTML=`<div class="city-name">${city.city}</div>
    <div class="city-bar-wrap"><div class="city-bar" style="width:${pct}%;background:${COLORS[i]}">${city.orders.toLocaleString()} orders</div></div>
    <div class="city-val">₹${(city.revenue/100000).toFixed(1)}L</div>`;
  cityEl.appendChild(div);
});

new Chart(document.getElementById('cuisineChart'),{
  type:'bar',
  data:{labels:DATA.cuisines.map(c=>c.cuisine),datasets:[{label:'Orders',data:DATA.cuisines.map(c=>c.orders),backgroundColor:COLORS,borderRadius:6}]},
  options:{responsive:true,indexAxis:'y',plugins:{legend:{display:false}}}
});

new Chart(document.getElementById('cuisineRevChart'),{
  type:'doughnut',
  data:{labels:DATA.cuisines.map(c=>c.cuisine),datasets:[{data:DATA.cuisines.map(c=>c.revenue),backgroundColor:COLORS,borderWidth:0,hoverOffset:10}]},
  options:{responsive:true,plugins:{legend:{position:'right',labels:{font:{size:9}}}}}
});
</script>
