<style>
  :root {
    --bg: #0a0a0f;
    --surface: #111118;
    --surface2: #16161f;
    --border: #1e1e2e;
    --accent: #ff4d00;
    --accent2: #ff8c42;
    --accent3: #ffd166;
    --green: #06d6a0;
    --blue: #118ab2;
    --purple: #9b5de5;
    --text: #e8e8f0;
    --muted: #6b6b80;
    --card-glow: 0 0 40px rgba(255,77,0,0.06);
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font-family:'DM Mono',monospace; min-height:100vh; overflow-x:hidden; }

  /* Grain overlay */
  body::before {
    content:''; position:fixed; inset:0; pointer-events:none; z-index:999;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    opacity:0.4;
  }

  header {
    padding: 32px 40px 24px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    background: linear-gradient(180deg, rgba(255,77,0,0.04) 0%, transparent 100%);
  }
  .logo { display:flex; align-items:center; gap:12px; }
  .logo-dot { width:10px; height:10px; background:var(--accent); border-radius:50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{box-shadow:0 0 0 0 rgba(255,77,0,0.4)} 50%{box-shadow:0 0 0 8px rgba(255,77,0,0)} }
  h1 { font-family:'Syne',sans-serif; font-size:22px; font-weight:800; letter-spacing:-0.5px; }
  h1 span { color:var(--accent); }
  .subtitle { font-size:11px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-top:2px; }
  .badge { background:rgba(255,77,0,0.1); border:1px solid rgba(255,77,0,0.3); color:var(--accent2); font-size:10px; padding:4px 10px; border-radius:20px; letter-spacing:1px; }

  /* NAV TABS */
  .nav { display:flex; gap:4px; padding:20px 40px 0; border-bottom:1px solid var(--border); }
  .tab { padding:10px 20px; font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); cursor:pointer; border-bottom:2px solid transparent; transition:all 0.2s; font-family:'Syne',sans-serif; font-weight:600; }
  .tab:hover { color:var(--text); }
  .tab.active { color:var(--accent); border-bottom-color:var(--accent); }

  /* PAGES */
  .page { display:none; padding:32px 40px; animation: fadein 0.3s ease; }
  .page.active { display:block; }
  @keyframes fadein { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }

  /* KPI CARDS */
  .kpi-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-bottom:32px; }
  .kpi { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:20px; position:relative; overflow:hidden; transition:border-color 0.2s; }
  .kpi:hover { border-color:rgba(255,77,0,0.3); box-shadow:var(--card-glow); }
  .kpi::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--accent),var(--accent2)); opacity:0; transition:opacity 0.2s; }
  .kpi:hover::before { opacity:1; }
  .kpi-label { font-size:10px; color:var(--muted); letter-spacing:1.5px; text-transform:uppercase; margin-bottom:10px; }
  .kpi-value { font-family:'Syne',sans-serif; font-size:26px; font-weight:800; color:var(--text); }
  .kpi-value.accent { color:var(--accent); }
  .kpi-sub { font-size:10px; color:var(--muted); margin-top:6px; }
  .kpi-icon { position:absolute; top:16px; right:16px; font-size:20px; opacity:0.3; }

  /* SECTION TITLES */
  .section-title { font-family:'Syne',sans-serif; font-size:13px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:20px; display:flex; align-items:center; gap:10px; }
  .section-title::after { content:''; flex:1; height:1px; background:var(--border); }

  /* CHART CARDS */
  .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
  .grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:24px; }
  .card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:24px; }
  .card-title { font-size:11px; color:var(--muted); letter-spacing:1.5px; text-transform:uppercase; margin-bottom:20px; font-family:'Syne',sans-serif; font-weight:600; }
  .card canvas { max-height:220px; }

  /* COHORT HEATMAP */
  .cohort-table { width:100%; border-collapse:collapse; font-size:11px; }
  .cohort-table th { text-align:center; padding:6px 8px; color:var(--muted); font-weight:400; letter-spacing:1px; font-size:10px; }
  .cohort-table th:first-child { text-align:left; }
  .cohort-table td { text-align:center; padding:5px 4px; border-radius:4px; font-size:11px; font-weight:500; transition:transform 0.1s; cursor:default; }
  .cohort-table td:hover { transform:scale(1.1); z-index:1; position:relative; }
  .cohort-table td:first-child { text-align:left; color:var(--muted); font-size:10px; padding-right:12px; }

  /* RFM SEGMENTS */
  .rfm-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .rfm-card { background:var(--surface2); border:1px solid var(--border); border-radius:10px; padding:16px; position:relative; overflow:hidden; }
  .rfm-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; }
  .rfm-seg-name { font-family:'Syne',sans-serif; font-size:13px; font-weight:700; margin-bottom:12px; }
  .rfm-stats { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; }
  .rfm-stat { }
  .rfm-stat-val { font-size:14px; font-weight:600; font-family:'Syne',sans-serif; }
  .rfm-stat-lbl { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-top:2px; }
  .rfm-count { position:absolute; top:12px; right:14px; font-size:11px; color:var(--muted); }

  /* CITY BAR */
  .city-row { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
  .city-name { width:90px; font-size:11px; color:var(--muted); }
  .city-bar-wrap { flex:1; background:var(--surface2); border-radius:4px; height:20px; overflow:hidden; }
  .city-bar { height:100%; border-radius:4px; display:flex; align-items:center; padding-left:8px; font-size:10px; font-weight:600; transition:width 1s ease; }
  .city-val { width:80px; text-align:right; font-size:11px; font-family:'Syne',sans-serif; }

  /* INSIGHT CHIPS */
  .insights { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
  .insight { background:var(--surface2); border:1px solid var(--border); border-radius:8px; padding:12px 16px; font-size:11px; line-height:1.5; flex:1; min-width:200px; }
  .insight strong { color:var(--accent2); display:block; font-family:'Syne',sans-serif; font-size:12px; margin-bottom:4px; }

  .full-card { grid-column:1/-1; }
  @media(max-width:900px) { .kpi-grid{grid-template-columns:repeat(2,1fr)} .grid-2,.grid-3{grid-template-columns:1fr} }
</style>
